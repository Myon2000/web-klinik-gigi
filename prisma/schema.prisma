// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

enum AppointmentStatus {
  MENUNGGU_JADWAL
  MENUNGGU_KONFIRMASI
  TERKONFIRMASI
  SELESAI
  BATAL
}

model Appointment {
  id           Int               @id @default(autoincrement())
  token        String            @unique @default(uuid())
  nama         String
  nomorHp      String            @map("nomor_hp")
  tempatLahir  String            @map("tempat_lahir")
  tanggalLahir DateTime          @map("tanggal_lahir")
  alamat       String
  keluhan      String
  tanggalJanji DateTime?         @map("tanggal_janji")
  jamJanji     String?           @map("jam_janji")
  status       AppointmentStatus @default(MENUNGGU_JADWAL)
  tindakan     String?
  biaya        Decimal?          @db.Decimal(12, 2)
  sumber       String            @default("WEB") // "WEB" atau "MANUAL"
  isRead       Boolean           @default(false) @map("is_read")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("appointments")
}

model ClinicSetting {
  id           Int      @id @default(1)
  isOpen       Boolean  @default(true) @map("is_open")
  announcement String?  @default("")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("clinic_settings")
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

